    {
      "cell_type": "markdown",
      "metadata": {
        "id": "L5ElJr7f5fkM"
      },
      "source": [
        "## 4. Text Preprocessing"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 14,
      "metadata": {
        "id": "_EkV7qJo5fkM"
      },
      "outputs": [],
      "source": [
        "def clean_text(text):\n",
        "    if not isinstance(text, str):\n",
        "        return ''\n",
        "    text = text.lower()\n",
        "    text = re.sub(r\"\\n\", \" \", text)\n",
        "    text = re.sub(r\"https?://\\S+|www\\.\\S+\", \"\", text)\n",
        "    text = re.sub(r\"['’]\", \"\", text)\n",
        "    text = re.sub(r\"[^a-zA-Z\\s]\", \" \", text)\n",
        "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
        "    return text\n",
        "\n",
        "train_df['cleaned_text'] = train_df['comment_text'].apply(clean_text)\n",
        "test_df['cleaned_text'] = test_df['comment_text'].apply(clean_text)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "N5Tfd4d05fkN"
      },
      "source": [
        "## 5. Tokenization and Sequence Padding"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 15,
      "metadata": {
        "id": "35x5C2ft5fkN"
      },
      "outputs": [],
      "source": [
        "# Preprocessing parameters\n",
        "MAX_WORDS = 20000\n",
        "MAX_LEN = 150\n",
        "EMBEDDING_DIM = 128\n",
        "\n",
        "tokenizer = Tokenizer(num_words=MAX_WORDS, oov_token=\"<OOV>\")\n",
        "tokenizer.fit_on_texts(train_df['cleaned_text'])\n",
        "\n",
        "X_seq = tokenizer.texts_to_sequences(train_df['cleaned_text'])\n",
        "\n",
        "X_padded = pad_sequences(X_seq, maxlen=MAX_LEN, padding='post', truncating='post')\n",
        "y = train_df[label_cols].values\n",
        "\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "izQV5kp75fkN"
      },
      "source": [
        "## 6. Train-Validation Split"
      ]
