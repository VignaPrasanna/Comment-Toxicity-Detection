      "cell_type": "code",
      "execution_count": 16,
      "metadata": {
        "id": "NY2y-rrt5fkN"
      },
      "outputs": [],
      "source": [
        "X_train, X_val, y_train, y_val = train_test_split(\n",
        "    X_padded, y, test_size=0.2, random_state=42\n",
        ")"
      ]
    },
